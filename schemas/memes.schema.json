{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hahahah.culture.memes/v1",
  "title": "HAHahah meme notes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "reviewed_by", "next_review", "entries"],
  "properties": {
    "schema": { "const": "hahahah.culture.memes/v1" },
    "version": { "type": "string", "minLength": 1 },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "next_review": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "context", "avoid_when", "expires", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "pattern": { "type": "string", "minLength": 1 },
          "context": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "avoid_when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
