{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hahahah.profile/v1",
  "title": "HAHahah profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "persona",
    "locale",
    "intensity",
    "core",
    "budget_profile",
    "adapters",
    "budgets"
  ],
  "properties": {
    "schema": { "const": "hahahah.profile/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "persona": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 16 },
    "intensity": { "enum": ["low", "medium", "high"] },
    "core": { "type": "string", "minLength": 1 },
    "budget_profile": { "type": "string", "minLength": 1 },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["fake", "claude-code", "opencode", "agents-md", "antigravity", "qoder", "copilot"]
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "always_on_tokens",
        "skill_metadata_tokens",
        "skill_body_tokens",
        "reference_tokens_max"
      ],
      "properties": {
        "always_on_tokens": { "type": "integer", "minimum": 1 },
        "skill_metadata_tokens": { "type": "integer", "minimum": 1 },
        "skill_body_tokens": { "type": "integer", "minimum": 1 },
        "reference_tokens_max": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
