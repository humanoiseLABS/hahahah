{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hahahah.culture.lexicon/v1",
  "title": "HAHahah culture lexicon",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "locale", "version", "reviewed_by", "next_review", "entries"],
  "properties": {
    "schema": { "const": "hahahah.culture.lexicon/v1" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 16 },
    "version": { "type": "string", "minLength": 1 },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "next_review": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "term",
          "gloss",
          "register",
          "regions",
          "decay_class",
          "offensiveness",
          "contexts",
          "avoid_when",
          "max_per_response",
          "expires",
          "confidence",
          "sources"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "term": { "type": "string", "minLength": 1 },
          "gloss": { "type": "string", "minLength": 1 },
          "register": { "enum": ["informal", "neutral", "formal"] },
          "regions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "decay_class": {
            "enum": [
              "global-meme",
              "local-slang",
              "kbbi-colloquial",
              "aging-ironic",
              "dated",
              "banned"
            ]
          },
          "offensiveness": { "enum": ["none", "low", "medium", "high", "banned"] },
          "contexts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "avoid_when": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "max_per_response": { "type": "integer", "minimum": 0, "maximum": 5 },
          "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "confidence": { "enum": ["low", "medium", "high"] },
          "purpose": { "enum": ["usage", "awareness"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "note"],
              "properties": {
                "url": { "type": "string", "pattern": "^https?://" },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
