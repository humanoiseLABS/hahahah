{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hahahah.lexicon/v1",
  "title": "HAHahah persona lexicon",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "persona", "version", "entries"],
  "properties": {
    "schema": { "const": "hahahah.lexicon/v1" },
    "persona": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["culture_ref", "usage"],
        "properties": {
          "culture_ref": { "type": "string", "minLength": 1 },
          "usage": { "type": "string", "minLength": 1 },
          "max_per_response": { "type": "integer", "minimum": 0, "maximum": 5 }
        }
      }
    }
  }
}
