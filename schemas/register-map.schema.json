{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hahahah.culture.registers/v1",
  "title": "HAHahah Javanese register map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "locale",
    "version",
    "reviewed_by",
    "next_review",
    "levels",
    "honorifics",
    "defaults",
    "common_errors",
    "banyumasan",
    "sources"
  ],
  "properties": {
    "schema": { "const": "hahahah.culture.registers/v1" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 16 },
    "version": { "type": "string", "minLength": 1 },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "next_review": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ngoko", "madya", "krama"],
      "properties": {
        "ngoko": { "$ref": "#/definitions/level" },
        "madya": { "$ref": "#/definitions/level" },
        "krama": { "$ref": "#/definitions/level" }
      }
    },
    "honorifics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["krama_inggil", "krama_andhap"],
      "properties": {
        "krama_inggil": { "type": "string", "minLength": 1 },
        "krama_andhap": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "close_peer_or_younger",
        "unknown_or_status_unclear",
        "elder_teacher_official",
        "genuinely_unclear"
      ],
      "properties": {
        "close_peer_or_younger": { "type": "string", "minLength": 1 },
        "unknown_or_status_unclear": { "type": "string", "minLength": 1 },
        "elder_teacher_official": { "type": "string", "minLength": 1 },
        "genuinely_unclear": { "type": "string", "minLength": 1 }
      }
    },
    "common_errors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "banyumasan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_name", "note"],
      "properties": {
        "preferred_name": { "const": "Banyumasan" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https?://" }
    }
  },
  "definitions": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "pronouns", "markers"],
      "properties": {
        "use": { "type": "string", "minLength": 1 },
        "pronouns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["i", "you"],
          "properties": {
            "i": { "type": "string", "minLength": 1 },
            "you": { "type": "string", "minLength": 1 }
          }
        },
        "markers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
