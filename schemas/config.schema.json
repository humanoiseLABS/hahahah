{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hahahah.config/v1",
  "title": "HAHahah repository config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "adapters"],
  "properties": {
    "schema": { "const": "hahahah.config/v1" },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["claude-code", "agents-md", "fake"] }
    }
  }
}
