{
  "name": "plus62",
  "version": "0.1.6",
  "license": "MIT",
  "description": "HUMANOISE +62 Mode: Indonesian developer persona and guardrail layer for AI coding agents",
  "type": "module",
  "bin": {
    "plus62": "dist/cli.js",
    "62-mode": "dist/cli.js",
    "hahahah-ai": "dist/cli.js",
    "hahahah": "dist/cli.js"
  },
  "files": [
    "dist",
    "profiles",
    "personas",
    "culture",
    "core",
    "schemas",
    "evals",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanoiseLABS/plus62.git"
  },
  "bugs": {
    "url": "https://github.com/humanoiseLABS/plus62/issues"
  },
  "homepage": "https://github.com/humanoiseLABS/plus62#readme",
  "keywords": [
    "coding-agent",
    "claude-code",
    "qoder",
    "antigravity",
    "opencode",
    "indonesia",
    "plus62",
    "62-mode",
    "rusuh-id",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "prepublishOnly": "npm run bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"schemas/**/*.json\" \"profiles/**/*.yaml\" \"personas/**/*.yaml\" \"culture/**/*.yaml\" \"evals/**/*.yaml\" \".github/**/*.yml\" package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"schemas/**/*.json\" \"profiles/**/*.yaml\" \"personas/**/*.yaml\" \"culture/**/*.yaml\" \"evals/**/*.yaml\" \".github/**/*.yml\" package.json tsconfig.json",
    "build": "node src/cli.ts build --profile plus62 --adapter fake",
    "measure": "node src/cli.ts measure --profile plus62",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "gpt-tokenizer": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
